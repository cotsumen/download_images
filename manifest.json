{
  "manifest_version": 3,
  "name": "Download Images",
  "version": "1.0",
  "description": "ページ内に存在するimgタグに設定されたsrcを一括でダウンロードする。",
  "permissions": [
    "downloads",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }, 
  "icons": {
    "128": "icons/icon_128.png",
    "48": "icons/icon_48.png",
    "16": "icons/icon_16.png"
  }
}
